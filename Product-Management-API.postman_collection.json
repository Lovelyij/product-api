{
  "info": {
    "name": "Product Management API",
    "description": "CRUD endpoints for managing products in the e-commerce platform backend (Task 1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/products" },
    { "key": "productId", "value": "REPLACE_WITH_REAL_ID" }
  ],
  "item": [
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"price\": 15.99,\n  \"description\": \"Ergonomic wireless mouse\",\n  \"stockQuantity\": 50,\n  \"category\": \"Electronics\"\n}"
        },
        "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] }
      }
    },
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] }
      }
    },
    {
      "name": "Get Single Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{productId}}"]
        }
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 12.99,\n  \"stockQuantity\": 40\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{productId}}"]
        }
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{productId}}"]
        }
      }
    },
    {
      "name": "Create Product - Validation Error (missing name)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 10,\n  \"stockQuantity\": 5\n}"
        },
        "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] }
      }
    },
    {
      "name": "Create Product - Validation Error (price <= 0)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Broken Item\",\n  \"price\": 0,\n  \"stockQuantity\": 5\n}"
        },
        "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] }
      }
    }
  ]
}